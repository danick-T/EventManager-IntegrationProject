{
  "xsappname": "eventui",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Admin scope - full access to all entities"
    },
    {
      "name": "$XSAPPNAME.User",
      "description": "User scope - read events and sessions, register for sessions"
    }
  ],
  "role-templates": [
    {
      "name": "Admin",
      "description": "Administrator - full access",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "User",
      "description": "Regular user - limited access",
      "scope-references": [
        "$XSAPPNAME.User"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "EventSphere Admin",
      "description": "Full admin access to EventSphere",
      "role-template-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "EventSphere User",
      "description": "Regular user access to EventSphere",
      "role-template-references": [
        "$XSAPPNAME.User"
      ]
    }
  ]
}