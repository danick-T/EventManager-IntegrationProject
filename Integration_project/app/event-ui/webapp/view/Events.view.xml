<mvc:View controllerName="eventui.controller.Events"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="eventsPage" enableScrolling="true">

        <content>
            <VBox class="sapUiMediumMargin">

                <Breadcrumbs>
                    <Link text="{i18n>breadcrumbHome}"/>
                    <Link text="{i18n>breadcrumbEvents}"/>
                </Breadcrumbs>

                <Title text="{i18n>pageTitle}" level="H1"
                    class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>
                <Text text="{i18n>pageSubtitle}" class="sapUiSmallMarginBottom"/>

                <Panel expandable="false" expanded="true" class="sapUiSmallMarginBottom">
                    <headerToolbar>
                        <Toolbar>
                            <Button icon="sap-icon://filter" text="{i18n>filterSearch}" type="Transparent"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMargin">
                            <SearchField
                                id="searchField"
                                placeholder="{i18n>searchPlaceholder}"
                                width="250px"
                                search=".onFilterEvents"
                                class="sapUiSmallMarginEnd"/>
                            <Select id="statusFilter" width="180px"
                                change=".onFilterEvents"
                                items="{filters>/statuses}"
                                class="sapUiSmallMarginEnd">
                                <core:Item text="{filters>text}" key="{filters>key}"/>
                            </Select>
                            <Select id="locationFilter" width="180px"
                                change=".onFilterEvents"
                                items="{filters>/locations}"
                                class="sapUiSmallMarginEnd">
                                <core:Item text="{filters>text}" key="{filters>key}"/>
                            </Select>
                            <Button text="{i18n>applyFilters}" type="Emphasized" press=".onFilterEvents"/>
                        </HBox>
                    </content>
                </Panel>

                <Table
                    id="eventsTable"
                    items="{
                        path: '/Events',
                        parameters: {
                            $count: true,
                            $orderby: 'startDate asc'
                        }
                    }"
                    growing="true"
                    growingThreshold="6"
                    sticky="ColumnHeaders"
                    updateFinished=".onTableUpdateFinished">

                    <columns>
                        <Column width="22%"><Text text="{i18n>colEventTitle}"/></Column>
                        <Column width="28%"><Text text="{i18n>colDescription}"/></Column>
                        <Column width="15%"><Text text="{i18n>colLocation}"/></Column>
                        <Column width="18%"><Text text="{i18n>colDuration}"/></Column>
                        <Column width="8%"> <Text text="{i18n>colStatus}"/></Column>
                        <Column width="9%" hAlign="End"><Text text="{i18n>colAction}"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Navigation" press=".onViewDetails">
                            <cells>

                                <VBox>
                                    <Link text="{name}" press=".onViewDetails"/>
                                    <Text text="{parts: [{path: 'ID'}],
                                                  formatter: '.formatter.formatEventId'}"
                                          class="sapUiTinyMarginTop"/>
                                </VBox>

                                <Text text="{description}" wrapping="true"/>

                                <HBox alignItems="Center">
                                    <core:Icon src="sap-icon://map" class="sapUiTinyMarginEnd"/>
                                    <Text text="{location}"/>
                                </HBox>

                                <VBox>
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://calendar" class="sapUiTinyMarginEnd"/>
                                        <Text text="{parts: [{path: 'startDate'}],
                                                      formatter: '.formatter.formatDate'}"/>
                                    </HBox>
                                    <Text text="{parts: [{path: 'endDate'}],
                                                  formatter: '.formatter.formatDateEnd'}"
                                          class="sapUiTinyMarginTop"/>
                                </VBox>

                                <ObjectStatus
                                    text="{parts:  [{path: 'active'}, {path: 'startDate'}, {path: 'endDate'}],
                                           formatter: '.formatter.formatStatusText'}"
                                    state="{parts: [{path: 'active'}, {path: 'startDate'}, {path: 'endDate'}],
                                            formatter: '.formatter.formatStatusState'}"/>

                                <Button
                                    text="{i18n>viewDetails}"
                                    type="Transparent"
                                    icon="sap-icon://slim-arrow-right"
                                    iconFirst="false"
                                    press=".onViewDetails"/>

                            </cells>
                        </ColumnListItem>
                    </items>

                    <noData>
                        <IllustratedMessage
                            illustrationType="sapIllus-NoData"
                            title="{i18n>noDataTitle}"
                            description="{i18n>noDataDescription}"/>
                    </noData>

                </Table>

                <HBox justifyContent="Start" alignItems="Center"
                    class="sapUiSmallMarginTop sapUiSmallMarginBottom">
                    <Text id="tableCountText" text=""/>
                </HBox>

                <VBox alignItems="Center" class="sapUiLargeMarginTop sapUiLargeMarginBottom">
                    <core:Icon src="sap-icon://calendar" size="3rem" color="#0070F2"
                        class="sapUiSmallMarginBottom"/>
                    <Title text="{i18n>ctaTitle}" level="H4" class="sapUiSmallMarginBottom"/>
                    <Text text="{i18n>ctaDescription}" textAlign="Center"
                        class="sapUiSmallMarginBottom"/>
                    <Link text="{i18n>ctaLink}" press=".onRequestEvent"/>
                </VBox>

            </VBox>
        </content>
    </Page>

</mvc:View>