<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Bar>
        <contentLeft>
            <HBox alignItems="Center">
                <core:Icon src="sap-icon://calendar" size="1.5rem" class="sapUiSmallMarginEnd"/>
                <Title text="EventSphere" level="H4"/>
            </HBox>
        </contentLeft>
        <contentMiddle>
            <IconTabBar
                id="mainNavBar"
                expanded="true"
                backgroundDesign="Transparent"
                headerDesign="Plain"
                select=".onNavSelect">
                <items>
                    <IconTabFilter text="{i18n>navEvents}" key="events" icon="sap-icon://calendar"/>
                    <IconTabFilter text="{i18n>navSessions}" key="sessions" icon="sap-icon://group"/>
                    <IconTabFilter text="{i18n>navDashboard}" key="dashboard" icon="sap-icon://grid"
                        visible="{= ${user>/role} === 'admin'}"/>
                </items>
            </IconTabBar>
        </contentMiddle>
        <contentRight>
            <Button icon="sap-icon://bell"/>
            <Button icon="sap-icon://action-settings"/>
            <Avatar initials="{user>/initials}" displaySize="XS"/>
        </contentRight>
    </Bar>
</core:FragmentDefinition>
