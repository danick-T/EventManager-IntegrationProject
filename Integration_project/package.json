{
  "name": "Integration_project",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9",
    "@cap-js/hana": "^1",
    "generator-easy-ui5": "^3.9.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/dev-cap-tools": "^1.31.0",
    "@types/openui5": "^1.145.0",
    "cds-plugin-ui5": "^0.13.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-event-ui": "cds watch --open eventui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "[hybrid]": {
          "kind": "hana"
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "kind": "mocked",
        "restrict_all_services": true,
        "users": {
          "*": false,
          "admin": { "password": "admin", "roles": ["Admin"] },
          "user":  { "password": "user",  "roles": ["User"]  }
        }
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/project1"
  ]
}